    <script>
        document.addEventListener('DOMContentLoaded', function() {
            
            // --- 1. LÓGICA DAS ABAS (TABS) ---
            const tabs = document.querySelectorAll('.nav-tab');
            const tabContents = document.querySelectorAll('.tab-content');

            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    const tabId = tab.getAttribute('data-tab');

                    // Desativa todas as abas e conteúdos
                    tabs.forEach(t => t.classList.remove('active'));
                    tabContents.forEach(c => {
                        c.classList.remove('active');
                        c.style.display = 'none'; // Garante que está oculto
                    });

                    // Ativa a aba e conteúdo clicado
                    tab.classList.add('active');
                    const activeContent = document.getElementById(tabId);
                    if (activeContent) {
                        activeContent.style.display = 'block';
                        activeContent.classList.add('active');
                        // Adiciona animação ao trocar de aba
                        activeContent.classList.remove('fade-in-up');
                        void activeContent.offsetWidth; // Truque para reiniciar a animação
                        activeContent.classList.add('fade-in-up');
                    }
                });
            });

            // --- 2. LÓGICA DE EXPANSÃO DOS CARTÕES (PMBOK CARDS) ---
            const cards = document.querySelectorAll('.pmbok-card');

            cards.forEach(card => {
                card.addEventListener('click', (e) => {
                    // Só expande se o clique NÃO foi no botão "Ver Documento"
                    if (!e.target.classList.contains('expand-btn')) {
                        card.classList.toggle('expanded');
                    }
                });
            });

            // --- 3. LÓGICA DO MODAL ---
            const modal = document.getElementById('projectModal');
            const modalCloseBtn = document.getElementById('modalCloseBtn');
            const modalTitle = document.getElementById('modalTitle');
            const modalBody = document.getElementById('modalBody');
            const expandButtons = document.querySelectorAll('.expand-btn');

            // Função para abrir o modal
            const openModal = (docId) => {
                // Aqui você pode carregar dados específicos baseado no docId
                modalTitle.textContent = `Documento: ${docId.charAt(0).toUpperCase() + docId.slice(1)}`;
                modalBody.innerHTML = `<p>Carregando conteúdo para <strong>${docId}</strong>... (Esta é uma simulação. O documento completo seria carregado aqui.)</p>`;
                
                modal.classList.add('active');
            };

            // Função para fechar o modal
            const closeModal = () => {
                modal.classList.remove('active');
            };

            // Adiciona ouvintes aos botões "Ver Documento Completo"
            expandButtons.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation(); // Impede que o card expanda/recolha
                    const docId = btn.getAttribute('data-modal');
                    openModal(docId);
                });
            });

            // Fechar modal ao clicar no 'X'
            modalCloseBtn.addEventListener('click', closeModal);

            // Fechar modal ao clicar fora do conteúdo
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    closeModal();
                }
            });

        });
    </script>
