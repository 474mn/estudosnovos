    <title>Template Mestre: Projeto Integrador PMBOK</title>
    <style>
        /* ===================================
           CSS VARIABLES - DESIGN SYSTEM
           (Exatamente como fornecido, mantendo a identidade)
        =================================== */
        :root {
            /* Primary Colors */
            --primary: #1e4b8a;
            --primary-light: #3a6bb5;
            --primary-dark: #0d2847;
            
            /* Secondary Colors */
            --secondary: #764ba2;
            --accent: #667eea;
            
            /* Neutral Colors */
            --white: #ffffff;
            --gray-50: #f9fafb;
            --gray-100: #f3f4f6;
            --gray-200: #e5e7eb;
            --gray-300: #d1d5db;
            --gray-600: #4b5563;
            --gray-800: #1f2937;
            --gray-900: #111827;
            
            /* Status Colors */
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --info: #3b82f6;
            
            /* Shadows */
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            
            /* Transitions */
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            
            /* Spacing */
            --space-1: 0.25rem;
            --space-2: 0.5rem;
            --space-3: 0.75rem;
            --space-4: 1rem;
            --space-6: 1.5rem;
            --space-8: 2rem;
        }

        /* ===================================
           RESET & BASE
        =================================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, var(--accent) 0%, var(--secondary) 100%);
            color: var(--gray-900);
            line-height: 1.6;
            min-height: 100vh;
        }

        /* ===================================
           LAYOUT
        =================================== */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: var(--space-6);
        }

        /* ===================================
           HEADER
        =================================== */
        .header {
            background: var(--white);
            border-radius: 16px;
            padding: var(--space-8);
            box-shadow: var(--shadow-xl);
            margin-bottom: var(--space-6);
            text-align: center;
        }

        .header-title {
            font-size: clamp(1.8rem, 4vw, 2.5rem);
            color: var(--primary);
            font-weight: 700;
            margin-bottom: var(--space-2);
        }

        .header-subtitle {
            font-size: 1.125rem;
            color: var(--gray-600);
            margin-bottom: var(--space-4);
        }

        .header-badge {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent), var(--secondary));
            color: var(--white);
            padding: var(--space-2) var(--space-4);
            border-radius: 50px;
            font-size: 0.875rem;
            font-weight: 600;
        }

        /* ===================================
           NAVIGATION TABS
        =================================== */
        .nav-tabs {
            display: flex;
            gap: var(--space-2);
            margin-bottom: var(--space-6);
            overflow-x: auto;
            padding-bottom: var(--space-2);
        }

        .nav-tab {
            background: var(--white);
            border: none;
            padding: var(--space-3) var(--space-6);
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            color: var(--gray-600);
            transition: var(--transition);
            white-space: nowrap;
            box-shadow: var(--shadow-md);
        }

        .nav-tab:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            color: var(--primary);
        }

        .nav-tab.active {
            background: var(--primary);
            color: var(--white);
        }

        /* ===================================
           PMBOK GRID
        =================================== */
        .pmbok-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: var(--space-6);
            margin-bottom: var(--space-6);
        }

        .pmbok-card {
            background: var(--white);
            border-radius: 16px;
            padding: var(--space-6);
            box-shadow: var(--shadow-lg);
            transition: var(--transition);
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .pmbok-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--accent);
            transform: scaleY(0);
            transition: var(--transition);
        }

        .pmbok-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-xl);
        }

        .pmbok-card:hover::before {
            transform: scaleY(1);
        }

        .pmbok-card-header {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            margin-bottom: var(--space-4);
        }

        .pmbok-card-number {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--accent), var(--secondary));
            color: var(--white);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .pmbok-card-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--gray-900);
        }

        .pmbok-card-description {
            color: var(--gray-600);
            margin-bottom: var(--space-4);
            line-height: 1.6;
        }

        .pmbok-card-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .pmbok-card.expanded .pmbok-card-content {
            max-height: 2000px;
        }

        .pmbok-card-section {
            background: var(--gray-50);
            padding: var(--space-4);
            border-radius: 12px;
            margin-bottom: var(--space-3);
        }

        .pmbok-card-section h4 {
            color: var(--primary);
            margin-bottom: var(--space-2);
            font-size: 1rem;
        }
        
        .pmbok-card-section p {
             color: var(--gray-800);
             font-size: 0.95rem;
        }

        .pmbok-card-section ul {
            list-style: none;
            padding-left: 0;
        }

        .pmbok-card-section li {
            padding: var(--space-2) 0;
            padding-left: var(--space-6);
            position: relative;
        }

        .pmbok-card-section li::before {
            content: '✓';
            position: absolute;
            left: var(--space-2);
            color: var(--success);
            font-weight: 700;
        }

        .expand-btn {
            width: 100%;
            background: var(--gray-100);
            border: none;
            padding: var(--space-3);
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            color: var(--primary);
            transition: var(--transition);
        }

        .expand-btn:hover {
            background: var(--primary);
            color: var(--white);
        }

        /* ===================================
           STATUS BADGE
        =================================== */
        .status-badge {
            display: inline-block;
            padding: var(--space-1) var(--space-3);
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: var(--space-2);
        }

        .status-badge.completed {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.in-progress {
            background: #fef3c7;
            color: #92400e;
        }

        .status-badge.planned {
            background: #dbeafe;
            color: #1e40af;
        }

        /* ===================================
           DATA INTEGRATION SECTION
        =================================== */
        .data-integration {
            background: var(--white);
            border-radius: 16px;
            padding: var(--space-8);
            box-shadow: var(--shadow-xl);
            margin-bottom: var(--space-6);
        }

        .data-integration-title {
            font-size: 1.5rem;
            color: var(--primary);
            margin-bottom: var(--space-6);
            text-align: center;
        }

        .data-sources {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: var(--space-4);
        }

        .data-source {
            background: var(--gray-50);
            padding: var(--space-4);
            border-radius: 12px;
            text-align: center;
            transition: var(--transition);
            cursor: pointer;
        }

        .data-source:hover {
            background: var(--primary);
            color: var(--white);
            transform: translateY(-4px);
        }

        .data-source-icon {
            font-size: 2rem;
            margin-bottom: var(--space-2);
        }

        .data-source h4 {
            font-size: 1rem;
            margin-bottom: var(--space-1);
        }
        
        .data-source p {
            font-size: 0.875rem;
            color: var(--gray-600);
        }
        
        .data-source:hover p {
            color: var(--gray-100);
        }

        /* ===================================
           MODAL
        =================================== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(8px);
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--white);
            border-radius: 20px;
            padding: var(--space-8);
            max-width: 900px;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            margin: var(--space-4);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
        
        .modal-content h2 {
            color: var(--primary);
            margin-bottom: var(--space-4);
        }

        .modal-close {
            position: absolute;
            top: var(--space-4);
            right: var(--space-4);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background: var(--gray-100);
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--gray-600);
            transition: var(--transition);
        }

        .modal-close:hover {
            background: var(--danger);
            color: var(--white);
            transform: rotate(90deg);
        }

        /* ===================================
           EXPORT BUTTONS
        =================================== */
        .export-section {
            background: var(--white);
            border-radius: 16px;
            padding: var(--space-8);
            box-shadow: var(--shadow-xl);
            text-align: center;
        }

        .export-buttons {
            display: flex;
            gap: var(--space-4);
            justify-content: center;
            flex-wrap: wrap;
        }

        .export-btn {
            background: var(--primary);
            color: var(--white);
            border: none;
            padding: var(--space-4) var(--space-8);
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: var(--shadow-md);
        }

        .export-btn:hover {
            background: var(--secondary);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .export-btn.secondary {
            background: var(--white);
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .export-btn.secondary:hover {
            background: var(--primary);
            color: var(--white);
        }
        
        /* ===================================
           TAB CONTENT
        =================================== */
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }

        /* ===================================
           RESPONSIVE
        =================================== */
        @media (max-width: 768px) {
            .container {
                padding: var(--space-4);
            }

            .header {
                padding: var(--space-6);
            }

            .pmbok-grid {
                grid-template-columns: 1fr;
            }

            .nav-tabs {
                justify-content: flex-start;
            }

            .export-buttons {
                flex-direction: column;
            }

            .export-btn {
                width: 100%;
            }
        }

        /* ===================================
           ANIMATIONS
        =================================== */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in-up {
            animation: fadeInUp 0.6s ease-out;
        }

        /* ===================================
           UTILITIES
        =================================== */
        .text-center { text-align: center; }
        .mt-4 { margin-top: var(--space-4); }
        .mb-4 { margin-bottom: var(--space-4); }
    </style>
</head>
